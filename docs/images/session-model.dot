digraph SessionModel {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.40",
    nodesep="0.50",
    ranksep="0.85",
    fontname="DejaVu Sans",
    label=<<FONT POINT-SIZE="11">El cliente aporta la credencial; el servidor resuelve la identidad y la caducidad.</FONT><BR/><BR/>>,
    labelloc="t",
    fontsize=20
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=14,
    margin="0.18,0.12",
    penwidth=1.2
  ];

  edge [
    color="#64748b",
    penwidth=1.4,
    arrowsize=0.8,
    fontname="DejaVu Sans",
    fontsize=11,
    fontcolor="#475569"
  ];

  subgraph cluster_client {
    label=<<B>Navegador (cliente)</B>>;
    labelloc="t";
    labeljust="c";
    fontname="DejaVu Sans";
    fontsize=14;
    color="#cbd5e1";
    style="rounded";
    bgcolor="#f8fafc";

    local [label=<<B>localStorage</B><BR/><BR/><FONT FACE="DejaVu Sans Mono" POINT-SIZE="12">pnl_session_token</FONT><BR/><FONT FACE="DejaVu Sans Mono" COLOR="#7c3aed" POINT-SIZE="14">"uuid-abc-123"</FONT><BR/><BR/><FONT POINT-SIZE="10" COLOR="#64748b">Email solo para prerrellenar el formulario</FONT>>, fillcolor="#ede9fe", color="#a855f7"];
  }

  subgraph cluster_server {
    label=<<B>Servidor (Apps Script)</B>>;
    labelloc="b";
    labeljust="c";
    fontname="DejaVu Sans";
    fontsize=14;
    color="#cbd5e1";
    style="rounded";
    bgcolor="#f8fafc";

    props [label="ScriptProperties\n\nPIN_SESSIONS\n\n{\l  \"uuid-abc-123\": {\l    email: \"docente@centro.es\",\l    exp: 173...\l  }\l}\l\n\nFuente de verdad: identidad + caducidad", fontname="DejaVu Sans Mono", fontsize=11, fillcolor="#dbeafe", color="#3b82f6"];
  }

  local:s -> props:n [label="  google.script.run(token)  ", labeljust="l"];
  props:e -> local:e [label="  email resuelto + exp  ", style=dashed, constraint=false, labeljust="r"];
}
