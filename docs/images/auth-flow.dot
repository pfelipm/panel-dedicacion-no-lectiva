digraph AuthFlow {
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.50",
    nodesep="0.30",
    ranksep="0.35",
    fontname="DejaVu Sans",
    label=<<B>Flujo de autenticación</B><BR/><FONT POINT-SIZE="10">Azul: sesión normal · Morado: respaldo con PIN · Rojo: denegado</FONT>>,
    labelloc="t",
    fontsize=20
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="DejaVu Sans",
    fontsize=14,
    margin="0.14,0.09",
    penwidth=1.2
  ];

  edge [
    color="#64748b",
    penwidth=1.3,
    arrowsize=0.8,
    fontname="DejaVu Sans",
    fontsize=11,
    fontcolor="#475569"
  ];

  start [label="Sesión de Google\n(cuenta resuelta)", fillcolor="#e2e8f0", color="#94a3b8"];
  init [label="getInitialData()", fillcolor="#dbeafe", color="#3b82f6", fontname="DejaVu Sans Mono", fontsize=13];
  ok [label="¿Cuenta\nautorizada?", shape=diamond, fillcolor="#fef9c3", color="#eab308", fontsize=13, margin="0.03,0.03"];
  auth [label="assertAuthorized()", fillcolor="#dbeafe", color="#3b82f6", fontname="DejaVu Sans Mono", fontsize=13];
  app [label="App", fillcolor="#dcfce7", color="#22c55e", fontsize=14];

  denied [label="[AUTH]\nAcceso denegado", fillcolor="#fee2e2", color="#ef4444", fontcolor="#991b1b"];
  overlay [label="Overlay\n«Acceder con PIN»", fillcolor="#f3e8ff", color="#a855f7"];
  pin [label="authenticateWithPin()", fillcolor="#f3e8ff", color="#a855f7", fontname="DejaVu Sans Mono", fontsize=12];
  valid [label="¿PIN válido y\nautorizado?", shape=diamond, fillcolor="#fef9c3", color="#eab308", fontsize=12, margin="0.03,0.03"];
  error [label="Rate limit\n(5 / 5 min)", fillcolor="#fee2e2", color="#ef4444", fontcolor="#991b1b", fontsize=12];
  token [label="Token de sesión\n8 h", fillcolor="#ede9fe", color="#8b5cf6"];
  init2 [label="getInitialData(token)", fillcolor="#dbeafe", color="#3b82f6", fontname="DejaVu Sans Mono", fontsize=12];
  app2 [label="App", fillcolor="#dcfce7", color="#22c55e", fontsize=14];

  start -> init;
  init -> ok;
  ok -> auth [label="  sí"];
  auth -> app;
  ok -> denied [label="  no"];
  denied -> overlay;
  overlay -> pin;
  pin -> valid;
  valid -> error [label="  no"];
  valid -> token [label="  sí"];
  token -> init2;
  init2 -> app2;
}
